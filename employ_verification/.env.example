PROJECT_ID=<Your GCP Project ID>
LOCATION=<Your GCP Location for Agent Engine, for example: us-central1>
STORAGE_BUCKET=<Your GCS Bucket starting with gs://>
GEMINI_ENTERPRISE_APP_ID=<Your Gemini Enterprise App ID>

# Gemini Enterprise region — must match where your GE app was provisioned.
# Use 'global' (default) for most setups, or 'us' / 'eu' for regional apps.
# This controls both the Discovery Engine API hostname and the locations/ path.
#   global → discoveryengine.googleapis.com  /locations/global/...
#   us     → us-discoveryengine.googleapis.com  /locations/us/...
#   eu     → eu-discoveryengine.googleapis.com  /locations/eu/...
GE_LOCATION=global

# Optional
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# Disable mTLS client certificates (required on corp machines with PKCS11 hardware certs)
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# -----------------------------------------------------------------------------
# Google OAuth direct On-Behalf-Of (emp_verify_google_oauth_v3) — NO STS/WIF
# -----------------------------------------------------------------------------
# The GE authorization resource uses a GCP OAuth 2.0 Web client (NOT Entra).
# Users authenticate via Google/Cloud Identity SSO; GE forwards the resulting
# Google OAuth ACCESS TOKEN (not an id_token) to the agent, which uses it
# directly for BigQuery — no token exchange of any kind.
#
# Get the client ID/secret from:
#   GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Required redirect URIs on that OAuth client:
#   https://vertexaisearch.cloud.google.com/oauth-redirect
#   https://vertexaisearch.cloud.google.com/static/oauth/oauth.html
#
# IMPORTANT: OAUTH_SCOPES must include the bigquery/cloud-platform scopes so
# Google's token endpoint actually issues (and GE forwards) an access_token
# with the right permissions. Including "openid" is fine and required for a
# stable user identity in GE, but if you ever see logs warning that a Google
# id_token (not an access_token) was forwarded, the fix is on the GE
# authorization resource / OAuth consent side — re-run
# scripts/setup_agent_auth.py --force and have the user re-consent.
OAUTH_CLIENT_ID=<GCP OAuth 2.0 Web client ID>
OAUTH_CLIENT_SECRET=<client secret>
OAUTH_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
OAUTH_SCOPES=https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloud-platform openid email profile
OBO_CREDENTIAL_MODE=google_direct

# Set to true to make a failed OBO credential build raise instead of silently
# falling back to ADC (the Reasoning Engine service account). Useful when
# validating OBO end-to-end — without it, a misconfiguration is invisible
# (the agent still returns data, just under the wrong identity).
# STRICT_OBO=true

# Manual test (no GE):
#   gcloud auth print-access-token | python scripts/verify_google_oauth.py -

# Optional: used by scripts/grant_permissions.py to also grant a specific
# named user direct BigQuery IAM (in addition to the Reasoning Engine service
# account's ADC-fallback permissions).
# GE_USER_PERMISSION=someone@yourcompany.com

# SSL / Certificate verification (for Windows corporate machines with custom CAs)
# If you see "CERTIFICATE_VERIFY_FAILED" errors during deployment, set one of:
#   SSL_VERIFY=false          → disables SSL verification (not recommended for production)
#   REQUESTS_CA_BUNDLE=C:\path\to\your-corporate-ca.pem  → use your corporate CA bundle
# Leave unset for normal SSL verification (default, recommended).
# SSL_VERIFY=false
# REQUESTS_CA_BUNDLE=C:\path\to\corporate-ca.pem
