PROJECT_ID=<Your GCP Project ID>
LOCATION=<Your GCP Location for Agent Engine, for example: us-central1>
STORAGE_BUCKET=<Your GCS Bucket starting with gs://, used for build artifacts/logs>
GEMINI_ENTERPRISE_APP_ID=<Your Gemini Enterprise App ID>

# Gemini Enterprise region — must match where your GE app was provisioned.
# Use 'global' (default) for most setups, or 'us' / 'eu' for regional apps.
GE_LOCATION=global

# Optional
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# Disable mTLS client certificates (required on corp machines with PKCS11 hardware certs)
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# -----------------------------------------------------------------------------
# v5 — Built-in Gemini Enterprise OAuth propagation (Agent Engine V2 ingress)
# -----------------------------------------------------------------------------
# This deployment uses Vertex AI Agent Engine's Bring-Your-Own-Dockerfile (BYOC)
# mode and registers with GE at the Agent Engine V2 ingress URL
# (".../reasoningEngines/{id}/api/{ROUTE}"), NOT the legacy "/a2a/v1" URL.
#
# IMPORTANT: OAuth token propagation on this path requires the hosting GCP
# project to be on Google's allowlist for this feature. Without it, the
# deployment and A2A wiring still work, but tools will see no propagated
# token and BigQuery calls fall back to the Reasoning Engine service account
# (logged clearly — see employee_agent/tools/bq_client.py).
#
# Get the OAuth client ID/secret from:
#   GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Required redirect URIs on that OAuth client:
#   https://vertexaisearch.cloud.google.com/oauth-redirect
#   https://vertexaisearch.cloud.google.com/static/oauth/oauth.html
OAUTH_CLIENT_ID=<GCP OAuth 2.0 Web client ID>
OAUTH_CLIENT_SECRET=<client secret>
OAUTH_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
OAUTH_SCOPES=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloud-platform

# Set to true to make an empty propagated token raise instead of silently
# falling back to ADC (the Reasoning Engine service account). Useful when
# validating OBO end-to-end.
# STRICT_OBO=true

# SSL / Certificate verification (for Windows corporate machines with custom CAs)
# SSL_VERIFY=false
# REQUESTS_CA_BUNDLE=C:\path\to\corporate-ca.pem
