# -----------------------------------------------------------------------------
# Employee Verification Agent — Microsoft Entra ID 3P OAuth + WIF Token Exchange
# -----------------------------------------------------------------------------
# This deployment uses Vertex AI Agent Engine's Bring-Your-Own-Dockerfile (BYOC)
# mode and registers with Gemini Enterprise at the Agent Engine V2 ingress URL
# (".../reasoningEngines/{id}/api/a2a/") with a Microsoft Entra ID
# authorization resource attached. GE forwards the end user's Entra JWT,
# Agent Engine's V2 ingress gateway rewrites it onto the Authorization
# header, and this agent exchanges it for a Google Cloud access token via
# Workforce Identity Federation (RFC 8693 STS) before calling BigQuery.

# --- GCP project / Agent Engine ---
PROJECT_ID=prj-us-bpg-agentspace-dev-b
LOCATION=us-central1
STORAGE_BUCKET=<Your GCS Bucket starting with gs://, used for build artifacts/logs>

# --- Gemini Enterprise app ---
GEMINI_ENTERPRISE_APP_ID=kpmg-entra-app
GE_LOCATION=global
GE_ACCESS_POLICY=ALL_USERS

# --- Authorization resource ---
AUTH_ID=auth-emp-verify

# --- Microsoft Entra ID app registration ---
ENTRA_TENANT_ID=your-azure-tenant-id
OAUTH_CLIENT_ID=your-entra-client-id
OAUTH_CLIENT_SECRET=your-entra-client-secret
# Either ENTRA_APP_ID (used to derive the api://{ENTRA_APP_ID}/access_as_user
# scope) or an explicit ENTRA_SCOPE override.
ENTRA_APP_ID=your-entra-api-app-id
# ENTRA_SCOPE=openid offline_access api://your-entra-api-app-id/access_as_user

# --- Workforce Identity Federation (Entra JWT -> Google STS exchange) ---
WIF_PROVIDER_RESOURCE=//iam.googleapis.com/locations/global/workforcePools/your-pool/providers/your-provider

# Set to true to make a missing propagated token (or missing WIF config)
# raise instead of silently falling back to ADC. Useful when validating
# OBO end-to-end.
STRICT_OBO=false

# Optional
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# Disable mTLS client certificates (required on corp machines with PKCS11 hardware certs)
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# SSL / Certificate verification (for Windows corporate machines with custom CAs)
# SSL_VERIFY=false
# REQUESTS_CA_BUNDLE=C:\path\to\corporate-ca.pem

