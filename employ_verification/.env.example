PROJECT_ID=<Your GCP Project ID>
LOCATION=<Your GCP Location for Agent Engine, for example: us-central1>
STORAGE_BUCKET=<Your GCS Bucket starting with gs://>
GEMINI_ENTERPRISE_APP_ID=<Your Gemini Enterprise App ID>
# NOTE: If an agent's config/<name>.yaml sets deploy.agent_authorization_id,
# that value takes priority over this one at deploy time (see
# scripts/deploy.py::_resolve_agent_authorization). This var is only used as
# a fallback / for agents that don't set a per-agent authorization ID.
AGENT_AUTHORIZATION=<projects/PROJECT_NUMBER/locations/us/authorizations/auth-employee-verification — use GE_LOCATION as the locations/ segment, not always global>

# Gemini Enterprise region — must match where your GE app was provisioned.
# Use 'global' (default) for most setups, or 'us' / 'eu' for regional apps.
# This controls both the Discovery Engine API hostname and the locations/ path.
#   global → discoveryengine.googleapis.com  /locations/global/...
#   us     → us-discoveryengine.googleapis.com  /locations/us/...
#   eu     → eu-discoveryengine.googleapis.com  /locations/eu/...
GE_LOCATION=global

# Optional
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# Disable mTLS client certificates (required on corp machines with PKCS11 hardware certs)
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# OAuth2 client ID and secret for creating new Gemini Enterprise authorization resources
# Used when deploying new agents that need their own authorization resource
# Get from: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Required redirect URIs on the OAuth client:
#   https://vertexaisearch.cloud.google.com/oauth-redirect
#   https://vertexaisearch.cloud.google.com/static/oauth/oauth.html
OAUTH_CLIENT_ID=YOUR_ENTRA_APP_CLIENT_ID
OAUTH_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET_HERE
OAUTH_AUTHORIZATION_URI=https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/authorize
OAUTH_TOKEN_URI=https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/token
OAUTH_SCOPES="openid email offline_access profile user.Read"
TENANT_ID=YOUR_AZURE_TENANT_ID

# -----------------------------------------------------------------------------
# On-Behalf-Of (OBO) — Entra ID -> Google Workforce Identity Federation (WIF)
# -----------------------------------------------------------------------------
# KPMG users authenticate with Entra ID. Gemini Enterprise forwards the user's
# Entra token to the agent, which exchanges it (via Google STS) for a federated
# Google access token so BigQuery runs AS THE USER. Requires the agent to be
# registered WITH an authorization resource (AGENT_AUTHORIZATION set, not 'none').
#
# For Entra OAuth authorization resources, point these at your tenant:
#   OAUTH_AUTHORIZATION_URI=https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/authorize
#   OAUTH_TOKEN_URI=https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/token
#
# For full OBO/WIF, OAUTH_CLIENT_ID should match the workforce provider's
# oidc.clientId OR identity must add a shadow provider for your app.
# Set WIF_PROVIDER_OIDC_CLIENT_ID to the clientId on the WIF provider for validation.
WIF_PROVIDER_OIDC_CLIENT_ID=YOUR_WIF_PROVIDER_OIDC_CLIENT_ID
WORKFORCE_POOL_ID=YOUR_WORKFORCE_POOL_ID
WORKFORCE_PROVIDER_ID=YOUR_WORKFORCE_PROVIDER_ID
WORKFORCE_POOL_LOCATION=global
# 'id_token' if the forwarded Entra token is an OIDC id_token (carries email
# claims); use 'jwt' if it is an Entra access token (aud=api://<APP_ID>).
# With the api://<APP_ID>/access_as_user scope above, GE forwards an access
# token, so use 'jwt'.
WIF_SUBJECT_TOKEN_TYPE=jwt
WIF_SCOPE=https://www.googleapis.com/auth/cloud-platform

# Set to true to make a failed OBO token exchange raise instead of silently
# falling back to ADC (the Reasoning Engine service account). Useful when
# validating OBO end-to-end — without it, WIF misconfiguration is invisible
# (the agent still returns data, just under the wrong identity).
# STRICT_OBO=true

# SSL / Certificate verification (for Windows corporate machines with custom CAs)
# If you see "CERTIFICATE_VERIFY_FAILED" errors during deployment, set one of:
#   SSL_VERIFY=false          → disables SSL verification (not recommended for production)
#   REQUESTS_CA_BUNDLE=C:\path\to\your-corporate-ca.pem  → use your corporate CA bundle
# Leave unset for normal SSL verification (default, recommended).
# SSL_VERIFY=false
# REQUESTS_CA_BUNDLE=C:\path\to\corporate-ca.pem
