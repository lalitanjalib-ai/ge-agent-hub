# =============================================================================
# emp_verify_google_oauth_v3 — Google OAuth direct OBO (no STS/WIF)
# =============================================================================
# Previous Entra/WIF config preserved in .env.old
#
# Setup:
#   1. Create OAuth 2.0 Web client in GCP Console → APIs & Services → Credentials
#      Redirect URIs:
#        https://vertexaisearch.cloud.google.com/oauth-redirect
#        https://vertexaisearch.cloud.google.com/static/oauth/oauth.html
#   2. Fill OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET below
#   3. python scripts/setup_agent_auth.py --id auth-emp-verify-google-oauth-v3
#   4. python scripts/deploy.py emp_verify_google_oauth_v3
#
# Test without GE:
#   gcloud auth print-access-token | python scripts/verify_google_oauth.py -

# =============================================================================
# Core GCP / Agent Engine
# =============================================================================
PROJECT_ID=prj-us-bpg-spark-poc
LOCATION=us-central1
STORAGE_BUCKET="gs://a2ui-kpmg"
GEMINI_ENTERPRISE_APP_ID=enterprise-search-kpmg-non_1745846447042

GE_LOCATION=us

# Created by setup_agent_auth.py for emp_verify_google_oauth_v3
AGENT_AUTHORIZATION=projects/901535160018/locations/us/authorizations/auth-emp-verify-google-oauth-v3

# =============================================================================
# Vertex AI / GenAI
# =============================================================================
GOOGLE_CLOUD_PROJECT=prj-us-bpg-spark-poc
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_GENAI_MODEL=gemini-2.5-flash
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# =============================================================================
# Google OAuth — GE authorization resource (serverSideOauth2)
# =============================================================================
# Replace with your GCP OAuth 2.0 Web application client (NOT the Entra app).
OAUTH_CLIENT_ID=YOUR_GCP_OAUTH_WEB_CLIENT_ID
OAUTH_CLIENT_SECRET=YOUR_GCP_OAUTH_WEB_CLIENT_SECRET
OAUTH_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
OAUTH_SCOPES="https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloud-platform openid email profile"

# Direct Google OBO — agent uses forwarded Google access token; no STS/WIF
OBO_CREDENTIAL_MODE=google_direct

# User email for IAM grants (Cloud Identity principal, not workforce pool)
GE_USER_PERMISSION=mbondili@kpmg.com

# Set to true to fail loudly if OBO token missing/invalid (no silent SA fallback)
# STRICT_OBO=true

# =============================================================================
# SSL (corporate proxy)
# =============================================================================
SSL_VERIFY=false
