# Local A2UI development (poc sample agent)
#
# Copy to .env and fill in your GCP project for Vertex AI Gemini access.

GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Optional model override (codelab uses gemini-3-flash-preview when available)
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# Windows corporate proxy / custom CA (uncomment if needed)
# SSL_VERIFY=false
